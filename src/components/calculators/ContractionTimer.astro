---
// A private, on-device contraction timer. Tap to start/stop each contraction;
// it tracks duration and frequency and flags the 5-1-1 pattern.
---

<div class="ct card">
  <div class="ct-live">
    <p class="k">Current contraction</p>
    <p class="timer" id="ct-timer">0:00</p>
    <button class="btn block" id="ct-toggle">Start contraction</button>
    <div class="ct-actions">
      <button class="btn ghost" id="ct-clear" type="button">Clear all</button>
    </div>
  </div>

  <div class="ct-summary" id="ct-summary" hidden>
    <div class="stat-grid">
      <div class="cell"><p class="k">Avg duration</p><p class="v" id="ct-avgdur">—</p></div>
      <div class="cell"><p class="k">Avg frequency</p><p class="v" id="ct-avgfreq">—</p></div>
      <div class="cell"><p class="k">Recorded</p><p class="v" id="ct-count">0</p></div>
      <div class="cell"><p class="k">Pattern (last hr)</p><p class="v" id="ct-pattern">—</p></div>
    </div>
  </div>

  <div class="callout ct-511">
    <p class="note" style="margin:0">
      <b>The 5-1-1 rule:</b> contractions about <b>5 minutes</b> apart, each lasting
      <b>1 minute</b>, sustained for <b>1 hour</b> often means it’s time to call your provider or
      head in. Follow your own provider’s instructions, and go sooner if your waters break or
      you’re worried.
    </p>
  </div>

  <div class="ct-log" id="ct-log" hidden>
    <h3 class="ct-logh">History</h3>
    <table>
      <thead>
        <tr><th>#</th><th>Start</th><th>Duration</th><th>Gap</th></tr>
      </thead>
      <tbody id="ct-rows"></tbody>
    </table>
  </div>
</div>

<style>
  .ct { padding: clamp(18px, 4vw, 24px); }
  .ct-live { text-align: center; }
  .ct-live .k {
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--ink-soft); margin: 0 0 6px;
  }
  .timer {
    font-family: var(--serif); font-size: clamp(3rem, 14vw, 4.5rem);
    font-weight: 500; margin: 0 0 14px; line-height: 1; font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .ct-toggle--active { background: var(--mulberry-deep) !important; }
  .ct-actions { margin-top: 10px; }
  .ct-actions .btn { padding: 9px 18px; font-size: 0.9rem; }
  .ct-summary { margin-top: 22px; }
  .ct-511 { margin-top: 18px; }
  .ct-log { margin-top: 22px; }
  .ct-logh { font-size: 1rem; margin-bottom: 8px; }
  .ct-log table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .ct-log th {
    text-align: left; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--ink-soft); font-weight: 600; padding: 6px 8px; border-bottom: 1px solid var(--line);
  }
  .ct-log td { padding: 8px; border-bottom: 1px solid var(--line); font-variant-numeric: tabular-nums; }
  .ct-log tr:last-child td { border-bottom: 0; }
</style>

<script>
  interface C { start: number; end: number | null }
  const KEY = 'mb_contractions';
  const $ = (id: string) => document.getElementById(id);

  let list: C[] = load();
  let active: C | null = null;
  let raf = 0;

  function load(): C[] {
    try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; }
  }
  function save() {
    try { localStorage.setItem(KEY, JSON.stringify(list)); } catch {}
  }
  function mmss(ms: number) {
    const s = Math.max(0, Math.floor(ms / 1000));
    return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
  }
  function mins(ms: number) {
    const m = ms / 60000;
    return m < 1 ? Math.round(ms / 1000) + 's' : m.toFixed(1) + 'm';
  }

  const timerEl = $('ct-timer')!;
  const toggle = $('ct-toggle') as HTMLButtonElement;

  function tick() {
    if (active) {
      timerEl.textContent = mmss(Date.now() - active.start);
      raf = requestAnimationFrame(tick);
    }
  }

  toggle.addEventListener('click', () => {
    if (active) {
      active.end = Date.now();
      list.push(active);
      active = null;
      cancelAnimationFrame(raf);
      timerEl.textContent = '0:00';
      toggle.textContent = 'Start contraction';
      toggle.classList.remove('ct-toggle--active');
      save();
      render();
    } else {
      active = { start: Date.now(), end: null };
      toggle.textContent = 'Stop contraction';
      toggle.classList.add('ct-toggle--active');
      tick();
    }
  });

  $('ct-clear')?.addEventListener('click', () => {
    if (list.length && !confirm('Clear all recorded contractions?')) return;
    list = [];
    active = null;
    cancelAnimationFrame(raf);
    timerEl.textContent = '0:00';
    toggle.textContent = 'Start contraction';
    toggle.classList.remove('ct-toggle--active');
    save();
    render();
  });

  function render() {
    const done = list.filter((c) => c.end);
    const summary = $('ct-summary')!;
    const log = $('ct-log')!;
    if (!done.length) {
      summary.hidden = true;
      log.hidden = true;
      return;
    }
    summary.hidden = false;
    log.hidden = false;

    const durations = done.map((c) => (c.end as number) - c.start);
    const avgDur = durations.reduce((a, b) => a + b, 0) / durations.length;

    const gaps: number[] = [];
    for (let i = 1; i < done.length; i++) gaps.push(done[i].start - done[i - 1].start);
    const avgGap = gaps.length ? gaps.reduce((a, b) => a + b, 0) / gaps.length : 0;

    ($('ct-avgdur') as HTMLElement).textContent = mins(avgDur);
    ($('ct-avgfreq') as HTMLElement).textContent = gaps.length ? mins(avgGap) + ' apart' : '—';
    ($('ct-count') as HTMLElement).textContent = String(done.length);

    // 5-1-1 check over the last hour.
    const hourAgo = Date.now() - 3600000;
    const recent = done.filter((c) => c.start >= hourAgo);
    let pattern = 'Building';
    if (recent.length >= 8) {
      const rGaps: number[] = [];
      for (let i = 1; i < recent.length; i++) rGaps.push(recent[i].start - recent[i - 1].start);
      const rAvgGap = rGaps.reduce((a, b) => a + b, 0) / rGaps.length / 60000;
      const rAvgDur = recent.map((c) => (c.end as number) - c.start).reduce((a, b) => a + b, 0) / recent.length / 60000;
      if (rAvgGap <= 5.5 && rAvgDur >= 0.9) pattern = '5-1-1 met ✓';
    }
    ($('ct-pattern') as HTMLElement).textContent = pattern;

    const rows = $('ct-rows')!;
    rows.innerHTML = '';
    for (let i = done.length - 1; i >= 0; i--) {
      const c = done[i];
      const dur = (c.end as number) - c.start;
      const gap = i > 0 ? c.start - done[i - 1].start : null;
      const tr = document.createElement('tr');
      const startStr = new Date(c.start).toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
      tr.innerHTML = `<td>${i + 1}</td><td>${startStr}</td><td>${mmss(dur)}</td><td>${gap !== null ? mins(gap) : '—'}</td>`;
      rows.appendChild(tr);
    }
  }

  render();
</script>
