---
import { site, organizationSchema, webSiteSchema } from '@/data/site';

interface Props {
  title: string;
  description?: string;
  /** Path-only canonical, e.g. "/tools/". Defaults to current path. */
  path?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** ISO date — emitted as article:published_time for article pages. */
  publishedTime?: string;
  /** ISO date — emitted as article:modified_time for article pages. */
  modifiedTime?: string;
  /** Optional JSON-LD object(s) injected into the head. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  path,
  image = site.ogImage,
  imageAlt = site.ogImageAlt,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;

const canonicalPath = path ?? Astro.url.pathname;
const canonical = new URL(canonicalPath, site.url).href;
const ogImage = new URL(image, site.url).href;
const fullTitle = title.includes(site.name) ? title : `${title} · ${site.name}`;

// Per-page schemas, plus the sitewide Organization + WebSite graph that gives
// every page a resolvable brand entity (good for SEO and AI answer engines).
const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const graph = {
  '@context': 'https://schema.org',
  '@graph': [organizationSchema, webSiteSchema],
};

// Let modern crawlers show rich previews while still honouring noindex.
const robots = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.author} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<link rel="alternate" hreflang={site.lang} href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={site.ogLocale} />
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && (modifiedTime || publishedTime) && (
  <meta property="article:modified_time" content={modifiedTime ?? publishedTime} />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={site.twitter} />
<meta name="twitter:creator" content={site.twitter} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
{
  pageSchemas.map((schema) => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  ))
}
