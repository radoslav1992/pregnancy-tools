---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolCard from '@/components/ToolCard.astro';
import type { Tool } from '@/data/tools';
import { tools } from '@/data/tools';
import { site, MEDICAL_DISCLAIMER } from '@/data/site';

interface FAQ { q: string; a: string }

interface Props {
  tool: Tool;
  intro?: string;
  faqs?: FAQ[];
}

const { tool, intro, faqs = [] } = Astro.props;
const others = tools.filter((t) => t.slug !== tool.slug).slice(0, 4);

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: tool.title,
    url: `${site.url}/tools/${tool.slug}/`,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires a modern web browser with JavaScript.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: tool.description,
    inLanguage: site.lang,
    isAccessibleForFree: true,
    keywords: tool.keywords.join(', '),
    publisher: { '@id': `${site.url}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: `${site.url}/tools/` },
      { '@type': 'ListItem', position: 3, name: tool.title, item: `${site.url}/tools/${tool.slug}/` },
    ],
  },
];

if (faqs.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<BaseLayout
  title={`${tool.title} — ${tool.short}`}
  description={tool.description}
  path={`/tools/${tool.slug}/`}
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="wrap narrow">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span>
        <a href="/tools/">Tools</a> <span aria-hidden="true">/</span>
        <span aria-current="page">{tool.title}</span>
      </nav>

      <p class="eyebrow">{tool.icon} Pregnancy tool</p>
      <h1>{tool.title}</h1>
      <p class="lede">{intro ?? tool.description}</p>

      <div style="margin-top:24px">
        <slot />
      </div>

      <div class="callout" style="margin-top:24px">
        <p class="note"><b>Remember:</b> {MEDICAL_DISCLAIMER}</p>
      </div>

      {
        faqs.length > 0 && (
          <div class="faq">
            <h2>Common questions</h2>
            {faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <p class="eyebrow">Keep exploring</p>
      <h2>More tools</h2>
      <div class="grid cols-2" style="margin-top:20px">
        {others.map((t) => <ToolCard tool={t} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .crumbs {
    font-size: 0.82rem;
    color: var(--ink-soft);
    margin-bottom: 16px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .crumbs a { color: var(--ink-soft); text-decoration: none; }
  .crumbs a:hover { color: var(--mulberry-deep); }
  .section.alt { background: var(--surface); border-top: 1px solid var(--line); }

  .faq { margin-top: 40px; }
</style>
